{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "AI Guard 主窗口的默认权限集",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:event:default",
    "core:app:default"
  ]
}
